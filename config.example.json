  "orchestration": {
    "rules": [
      {
        "id": "cs2-profile",
        "model": "automation_v2",
        "scope": {
          "field": "process.name",
          "op": "==",
          "value": "cs2.exe"
        },
        "when": {
          "mode": "state",
          "condition": {
            "field": "process.name",
            "op": "==",
            "value": "cs2.exe"
          }
        },
        "action": {
          "type": "activate_profile",
          "profile": "cs2_gamer"
        }
      },
      {
        "id": "low-health",
        "model": "automation_v2",
        "scope": {
          "field": "process.name",
          "op": "==",
          "value": "cs2.exe"
        },
        "when": {
          "mode": "state",
          "condition": {
            "field": "player.state.health",
            "op": "<",
            "value": 20
          }
        },
        "action": {
          "type": "trigger_effect",
          "effect": {
            "kind": "profile_effect",
            "name": "danger_red"
          },
          "lifetime": "while_true",
          "priority": 10,
          "composition": "overlay",
          "blend": "alpha"
        }
      },
      {
        "id": "kill-wave",
        "model": "automation_v2",
        "scope": {
          "field": "process.name",
          "op": "==",
          "value": "cs2.exe"
        },
        "when": {
          "mode": "event",
          "condition": {
            "event": "event.kill"
          }
        },
        "action": {
          "type": "trigger_effect",
          "effect": {
            "kind": "profile_effect",
            "name": "wave"
          },
          "lifetime": "one_shot",
          "priority": 20,
          "composition": "overlay",
          "blend": "alpha",
          "retrigger": "restart",
          "compatibility": {
            "lifecycle": "legacy_envelope",
            "duration_ms": 800,
            "fade_out_ms": 200
          }
        }
      }
    ]
  }
}
