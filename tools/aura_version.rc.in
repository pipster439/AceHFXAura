#include <windows.h>
1 VERSIONINFO
FILEVERSION @AURA_RC_VERSION@
PRODUCTVERSION @AURA_RC_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "AceHFXAura runtime"
   VALUE "FileVersion", "@AURA_VERSION@"
   VALUE "ProductName", "AceHFXAura"
   VALUE "ProductVersion", "@AURA_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
