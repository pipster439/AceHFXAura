  "orchestration": {
    "rules": [
      {
        "id": "binding-0",
        "model": "automation_v2",
        "scope": {
          "field": "process",
          "op": "==",
          "value": "cs2.exe"
        },
        "when": {
          "mode": "state",
          "condition": {
            "field": "player_state.health",
            "op": "<",
            "value": 20
          }
        },
        "action": {
          "type": "activate_profile",
          "profile": "danger_red"
        }
      },
      {
        "id": "binding-1",
        "model": "automation_v2",
        "scope": {
          "field": "process",
          "op": "==",
          "value": "cs2.exe"
        },
        "when": {
          "mode": "state",
          "condition": {
            "field": "round.bomb",
            "op": "==",
            "value": "planted"
          }
        },
        "action": {
          "type": "activate_profile",
          "profile": "bomb_pulse"
        }
      },
      {
        "id": "process-0",
        "model": "automation_v2",
        "when": {
          "mode": "state",
          "condition": {
            "field": "process",
            "op": "==",
            "value": "cs2.exe"
          }
        },
        "action": {
          "type": "activate_profile",
          "profile": "cs2_gamer"
        },
        "dnd": false
      },
      {
        "id": "process-1",
