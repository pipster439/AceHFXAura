{
  "default_profile": "desktop",
  "rules": [
    {
      "process": "cs2.exe",
      "profile": "cs2_gamer",
      "suppress_web_ui": false
    },
    {
      "process": "code.exe",
      "profile": "coding"
    },
    {
      "process": "devenv.exe",
      "profile": "coding"
    },
    {
      "process": "notepad.exe",
      "profile": "office"
    },
    {
      "process": "chrome.exe",
      "profile": "cyberpunk"
    }
  ],
  "gsi_bindings": [
    {
      "field": "player_state.health",
      "operator": "<",
      "value": 20,
      "profile": "danger_red"
    },
    {
      "field": "round.bomb",
      "operator": "==",
      "value": "planted",
      "profile": "bomb_pulse"
    }
  ],
  "profiles": {
    "desktop": {
      "type": "breathing",
      "color1": [0, 80, 200],
      "color2": [0, 10, 40],
      "period_ms": 3500
    },
    "danger_red": {
      "type": "breathing",
      "color1": [255, 0, 0],
      "color2": [60, 0, 0],
      "period_ms": 600
    },
    "bomb_pulse": {
      "type": "breathing",
      "color1": [255, 80, 0],
      "color2": [20, 0, 0],
      "period_ms": 500
    },
    "cs2_gamer": {
      "type": "custom_keymap",
      "bg": [0, 0, 0],
      "keys": {
        "WASD": [0, 255, 0],
        "ESC": [255, 0, 0],
        "SPACE": [0, 200, 255],
        "ARROWS": [255, 255, 0]
      }
    },
    "coding": {
      "type": "static",
      "color": [10, 30, 50],
      "keys": {
        "ESC": [255, 120, 0],
        "ENTER": [0, 255, 120],
        "TAB": [0, 200, 255]
      }
    },
    "cyberpunk": {
      "type": "custom_keymap",
      "bg": [10, 0, 20],
      "keys": {
        "WASD": [0, 255, 255],
        "ARROWS": [255, 0, 128],
        "SPACE": [255, 255, 0],
        "ESC": [0, 255, 255]
      }
    },
    "office": {
      "type": "static",
      "color": [40, 40, 40],
      "keys": {
        "ENTER": [0, 180, 255]
      }
    },
    "rainbow_wave": {
      "type": "wave",
      "period_ms": 4000
    }
  }
}
