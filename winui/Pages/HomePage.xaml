<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="RootPanel" Spacing="20" MaxWidth="1200" HorizontalAlignment="Left">

            <!-- 标题区 -->
            <StackPanel Spacing="4">
                <TextBlock Text="ROG Falchion Ace HFX 控制中心" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="硬件级单键 RGB 磁轴键盘控制与生态协同平台"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 状态卡片响应式网格 -->
            <Grid x:Name="CardGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CardGridCol0" Width="*" />
                    <ColumnDefinition x:Name="CardGridCol1" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. 设备状态卡片 -->
                <Border x:Name="DeviceCard"
                        Grid.Row="0" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE765;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="ROG Falchion Ace HFX" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="DeviceStatusText"
                                           Text="正在检测..."
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="BackendStatusText"
                                   Text="后端协议: 检测中..."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 2. 守护进程状态卡片 -->
                <Border x:Name="DaemonCard"
                        Grid.Row="0" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEC05;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="核心服务" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="DaemonStatusText" Text="正在检测..." Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="DaemonDetailText"
                                   Text="正在连接核心服务 (127.0.0.1:19897)..."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 3. 方案与渲染卡片 -->
                <Border x:Name="ProfileCard"
                        Grid.Row="1" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE706;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="当前灯效方案" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="ActiveProfileText" Text="--" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="FpsText"
                                   Text="渲染帧率: --"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 4. 游戏集成卡片 -->
                <Border x:Name="GsiCard"
                        Grid.Row="1" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7FC;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="游戏联动 (CS2 GSI)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="GsiStatusText" Text="空闲" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="炸弹倒计时、血量呼吸、击杀瞬态光效同步中"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 5. 快捷入口卡片 -->
                <Border x:Name="QuickCard"
                        Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快捷入口" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenStudioBtn"
                                    Grid.Column="0"
                                    Click="OpenStudioBtn_Click"
                                    AutomationProperties.Name="进入 Blockly 工作室"
                                    ToolTipService.ToolTip="进入 Blockly 工作室"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE943;" FontSize="16" />
                                    <TextBlock Text="进入 Blockly 工作室" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RefreshStatusBtn"
                                    Grid.Column="1"
                                    Click="RefreshStatusBtn_Click"
                                    AutomationProperties.Name="刷新核心状态"
                                    ToolTipService.ToolTip="刷新核心状态">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                    <TextBlock Text="刷新核心状态" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
