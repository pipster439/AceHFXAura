<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="36,24,36,36">
            <!-- 标题区 -->
            <StackPanel Spacing="4">
                <TextBlock Text="ROG Falchion Ace HFX 控制中心" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="硬件级单键 RGB 磁轴键盘控制与生态协同平台"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 状态卡片网格 -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 设备状态卡片 -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE765;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="连接设备" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="ROG Falchion Ace HFX (65%)" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="后端协议: Native Win32 HID (MI_01) 优先，ASUS HAL 兜底兼容"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 守护进程状态卡片 -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEC05;" FontSize="24" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <StackPanel>
                                <TextBlock Text="核心服务 (daemon)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="DaemonStatusText" Text="正在检测..." Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="前台应用窗口感应、60 FPS 硬件节流、规则引擎与热重载就绪"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 快速直达卡片 -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快捷入口" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="OpenStudioBtn"
                                    Click="OpenStudioBtn_Click"
                                    AutomationProperties.Name="进入 Blockly Studio"
                                    ToolTipService.ToolTip="进入 Blockly Studio"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE943;" FontSize="16" />
                                    <TextBlock Text="进入 Blockly Studio" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RefreshStatusBtn"
                                    Click="RefreshStatusBtn_Click"
                                    AutomationProperties.Name="刷新核心状态"
                                    ToolTipService.ToolTip="刷新核心状态">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                    <TextBlock Text="刷新核心状态" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 阶段迁移指引 -->
            <InfoBar Title="WinUI 3 迁移第一阶段 (Shell 就绪)"
                     Message="本版本已建立 WinUI 3 原生视窗、自适应导航与系统托盘。Studio 页面通过 WebView2 无缝嵌入本地 Blockly Web UI，核心灯效与硬件驱动不受任何影响。"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
