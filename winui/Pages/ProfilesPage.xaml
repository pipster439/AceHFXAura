<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Aura_WinUI.Pages.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <Style x:Key="ProfileEditorCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Visible">
        <StackPanel x:Name="PageContent" Spacing="18" MaxWidth="1420">
            <StackPanel Spacing="4">
                <TextBlock Text="配置文件" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="配置文件可管理磁轴设置，或选择由 ASUS 软件配置的板载槽位。编辑后先保存，再应用到键盘。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="DraftValidationBar" Title="请先修正草稿" Severity="Warning" IsClosable="False" />
            <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" />

            <Border Padding="18" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="当前选择" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HeroName" Text="正在加载…" Style="{ThemeResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ProfileCurrentName" />
                        <TextBlock x:Name="HeroState" Text="正在加载配置文件" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ProfileState" />
                        <TextBlock x:Name="HeroDescription" Text="正在从 Aura 后台读取配置…"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="HeroActions" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="True" />
                        <Button x:Name="RetryButton" Content="重试连接" Click="RetryButton_Click"
                                AutomationProperties.AutomationId="ProfileRetry" Visibility="Collapsed" />
                        <Button x:Name="RetryApplyButton" Content="重试应用" Click="RetryApplyButton_Click"
                                AutomationProperties.AutomationId="ProfileRetryApply" Visibility="Collapsed" />
                        <Button x:Name="DetailsButton" Content="查看详细信息" Click="DetailsButton_Click"
                                AutomationProperties.AutomationId="ProfileApplyDetails" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="SelectorGrid" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ComboBox x:Name="ProfilePicker" Header="浏览配置文件"
                          PlaceholderText="选择配置文件" DisplayMemberPath="Label"
                          HorizontalAlignment="Stretch" SelectionChanged="ProfilePicker_SelectionChanged"
                          AutomationProperties.AutomationId="ProfilePicker" />
                <CommandBar x:Name="ProfileCommands" Grid.Column="1" VerticalAlignment="Bottom"
                            DefaultLabelPosition="Right" OverflowButtonVisibility="Visible">
                    <AppBarButton x:Name="CreateButton" Icon="Add" Label="新建" Click="CreateButton_Click"
                                  AutomationProperties.AutomationId="ProfileCreate" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Name="DuplicateButton" Icon="Copy" Label="复制当前配置" Click="DuplicateButton_Click"
                                      AutomationProperties.AutomationId="ProfileDuplicate" />
                        <AppBarButton x:Name="RenameButton" Icon="Edit" Label="重命名" Click="RenameButton_Click"
                                      AutomationProperties.AutomationId="ProfileRename" />
                        <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="删除" Click="DeleteButton_Click"
                                      AutomationProperties.AutomationId="ProfileDelete" />
                        <AppBarSeparator />
                        <AppBarButton x:Name="DiagnosticsButton" Icon="Document" Label="高级诊断…" Click="DiagnosticsButton_Click"
                                      AutomationProperties.AutomationId="ProfileDiagnostics" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Grid>

            <Grid x:Name="EditorColumns" ColumnSpacing="20" RowSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ContentControl x:Name="EditorSurface" IsEnabled="False" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="EditorPanel" Spacing="16">
                    <Grid x:Name="EditorTitleGrid" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="EditorName" Text="磁轴配置" Style="{ThemeResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DraftStateText" Text="更改只影响草稿，保存后再应用。"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="SaveActions" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="SaveButton" Content="保存" Click="SaveButton_Click"
                                    AutomationProperties.AutomationId="ProfileSave" />
                            <Button x:Name="ApplyButton" Content="应用到键盘" Click="ApplyButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="ProfileApply" />
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="ConflictBar" IsOpen="False" IsClosable="False"
                             Severity="Warning" Title="配置已在其他位置更改"
                             Message="草稿已保留。检查新版本后，可以继续使用草稿，或放弃草稿。">
                        <InfoBar.ActionButton>
                            <Button Content="继续使用草稿" Click="KeepDraftButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <Button x:Name="DiscardDraftButton" Content="放弃草稿并使用最新版本"
                            Click="DiscardDraftButton_Click" Visibility="Collapsed" HorizontalAlignment="Left" />

                    <controls:SettingsCard Header="激活方式" IsClickEnabled="False">
                        <ComboBox x:Name="ActivationBackendPicker" SelectionChanged="ActivationBackendPicker_SelectionChanged"
                                  AutomationProperties.Name="配置文件激活方式" AutomationProperties.AutomationId="ProfileActivationBackend">
                            <x:String>Aura 管理磁轴设置</x:String>
                            <x:String>板载配置槽位</x:String>
                        </ComboBox>
                    </controls:SettingsCard>
                    <StackPanel x:Name="HardwareSlotPanel" Spacing="10" Visibility="Collapsed">
                        <ComboBox x:Name="HardwareSlotPicker" Header="目标板载槽位" PlaceholderText="选择配置文件 1–5"
                                  SelectionChanged="HardwareSlotPicker_SelectionChanged" AutomationProperties.AutomationId="ProfileHardwareSlot">
                            <x:String>配置文件 1</x:String><x:String>配置文件 2</x:String><x:String>配置文件 3</x:String>
                            <x:String>配置文件 4</x:String><x:String>配置文件 5</x:String>
                        </ComboBox>
                        <TextBlock Text="切换到此配置文件时，Aura只会激活键盘中的对应板载配置。板载配置的按键、磁轴和固件灯效内容请在 ASUS Gear Link / Armoury Crate 中编辑。"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="此槽位仍可被 Gear Link、Armoury Crate 或键盘硬件切换修改。Aura不会覆盖槽位内容。板载模式下 Aura 停止灯光帧输出，由键盘呈现板载灯效。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HardwareSlotStateText" TextWrapping="Wrap" />
                        <InfoBar x:Name="HardwareSlotWarning" Severity="Warning" IsClosable="False"
                                 Message="键盘当前槽位与此配置的目标不同；板载配置可能已被其它软件或硬件操作更改。Aura不会自动抢回槽位。" />
                        <Button Content="读取当前槽位" Click="HardwareSlotRefresh_Click" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ProfileRefreshHardwareSlot" />
                    </StackPanel>
                    <StackPanel x:Name="HostManagedEditor" Spacing="16">
                    <TextBlock Text="全局磁轴设置" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="覆盖整个配置文件的基础值；关闭自定义时使用全局默认值。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Style="{StaticResource ProfileEditorCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="触发点" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="0.1–4.0 mm" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="GlobalActFields" Spacing="6" HorizontalAlignment="Left">
                            <ToggleSwitch x:Name="GlobalActCustom" OnContent="自定义" OffContent="使用全局默认值" Tag="g_act"
                                          Toggled="OverrideToggle_Toggled" />
                            <TextBlock x:Name="GlobalActSource" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <Slider x:Name="GlobalActSlider" Tag="g_act" ValueChanged="ValueSlider_Changed"
                                    AutomationProperties.Name="配置文件触发点" />
                            <TextBlock x:Name="GlobalActValue" HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProfileEditorCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="死区" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="顶部与底部 · 0.0–0.5 mm" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="GlobalDzFields" Spacing="6" HorizontalAlignment="Left">
                            <ToggleSwitch x:Name="GlobalDzCustom" OnContent="自定义" OffContent="使用全局默认值" Tag="g_dz"
                                          Toggled="OverrideToggle_Toggled" />
                            <TextBlock x:Name="GlobalDzSource" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="顶部" /><Slider x:Name="GlobalTopSlider" Tag="g_top" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="配置文件顶部死区" />
                            <TextBlock x:Name="GlobalTopValue" HorizontalAlignment="Right" />
                            <TextBlock Text="底部" /><Slider x:Name="GlobalBottomSlider" Tag="g_bottom" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="配置文件底部死区" />
                            <TextBlock x:Name="GlobalBottomValue" HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="快速触发 · 按键配置" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Border Style="{StaticResource ProfileEditorCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="快速触发" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="选择要管理的按键，再为单键或多选键设置快速触发。键盘上的物理开关控制触发模式。"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="RtKeySetSummary" TextWrapping="Wrap" />
                            <InfoBar x:Name="HardwareRtGateBar" IsOpen="True" IsClosable="False"
                                     Severity="Informational" Title="硬件快速触发开关" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SelectEnabledRtButton" Content="选择已启用按键" Click="SelectEnabledRtButton_Click" />
                                <Button x:Name="SelectAllRtButton" Content="选择全部按键" Click="SelectAllRtButton_Click" />
                            </StackPanel>
                            <TextBlock Text="上方数量表示配置草稿，不代表键盘当前状态。多选会为每个选中按键保存独立设置。"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <controls:SettingsExpander x:Name="LegacyRtExpander" Header="旧版快速触发参数"
                                Description="无法自动迁移的旧版参数仅供检查。可移除后使用逐键设置，不能新增旧版参数。" IsExpanded="False">
                            <controls:SettingsExpander.Items>
                            <controls:SettingsCard IsClickEnabled="False" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="GlobalRtFields" Spacing="6" HorizontalAlignment="Left">
                            <ToggleSwitch x:Name="GlobalRtCustom" OnContent="保留旧版参数" OffContent="不使用旧版参数" Tag="g_rt"
                                          Toggled="OverrideToggle_Toggled" />
                            <TextBlock x:Name="GlobalRtSource" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="启用快速触发设置（旧版参数）" TextWrapping="Wrap" />
                            <TextBlock Text="此开关只检查旧版参数，不是键盘物理开关，也不控制逐键设置。可关闭‘保留旧版参数’，再使用下方逐键编辑器。"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <InfoBar x:Name="RapidTriggerValidationBar" Severity="Warning" IsClosable="False" />
                            <ToggleSwitch x:Name="GlobalRtEnabled" OnContent="开启" OffContent="关闭" AutomationProperties.Name="启用快速触发设置（旧版参数）"
                                          Toggled="GlobalSeparateToggle_Toggled" />
                            <TextBlock Text="灵敏度模式" />
                            <ToggleSwitch x:Name="GlobalSeparateToggle"
                                          OnContent="独立按下/抬起" OffContent="同步" Toggled="GlobalSeparateToggle_Toggled" />
                            <TextBlock Text="按下" /><Slider x:Name="GlobalPressSlider" Tag="g_press" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="配置文件快速触发按下灵敏度" />
                            <TextBlock x:Name="GlobalPressValue" HorizontalAlignment="Right" />
                            <TextBlock Text="抬起" /><Slider x:Name="GlobalReleaseSlider" Tag="g_release" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="配置文件快速触发抬起灵敏度" />
                            <TextBlock x:Name="GlobalReleaseValue" HorizontalAlignment="Right" />
                            <TextBlock Text="顶部死区" /><Slider x:Name="GlobalRtTopSlider" Tag="g_rt_top" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="配置文件快速触发顶部死区" />
                            <TextBlock x:Name="GlobalRtTopValue" HorizontalAlignment="Right" />
                            <TextBlock Text="底部死区" /><Slider x:Name="GlobalRtBottomSlider" Tag="g_rt_bottom" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="配置文件快速触发底部死区" />
                            <TextBlock x:Name="GlobalRtBottomValue" HorizontalAlignment="Right" />
                            </StackPanel>
                            </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                            </controls:SettingsExpander>
                            <InfoBar x:Name="KeyRtValidationBar" Severity="Warning" IsClosable="False" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="逐键覆盖" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="选择按键进行自定义。Ctrl+点击可多选；有覆盖的键会高亮。键盘只用于编辑配置，不显示实时行程。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MultiSelectButton" Content="多选" Click="MultiSelectButton_Click" />
                        <Button x:Name="ClearSelectionButton" Content="清除选择" Click="ClearSelectionButton_Click" />
                    </StackPanel>
                    <Border Padding="12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ScrollViewer x:Name="KeyboardViewport" HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="KeyboardRows" Spacing="5" HorizontalAlignment="Left" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="SelectedKeysText" Text="请选择按键" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Border Style="{StaticResource ProfileEditorCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="逐键触发点" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="关闭自定义可移除覆盖" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="KeyActFields" Spacing="6" HorizontalAlignment="Left">
                            <ToggleSwitch x:Name="KeyActCustom" OnContent="自定义" OffContent="使用配置文件默认值" Tag="k_act" Toggled="OverrideToggle_Toggled" />
                            <TextBlock x:Name="KeyActSource" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Slider x:Name="KeyActSlider" Tag="k_act" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="所选按键触发点" />
                            <TextBlock x:Name="KeyActValue" HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProfileEditorCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="逐键死区" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="关闭自定义可移除覆盖" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="KeyDzFields" Spacing="6" HorizontalAlignment="Left">
                            <ToggleSwitch x:Name="KeyDzCustom" OnContent="自定义" OffContent="使用配置文件默认值" Tag="k_dz" Toggled="OverrideToggle_Toggled" />
                            <TextBlock x:Name="KeyDzSource" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="顶部" /><Slider x:Name="KeyTopSlider" Tag="k_top" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="所选按键顶部死区" />
                            <TextBlock x:Name="KeyTopValue" HorizontalAlignment="Right" />
                            <TextBlock Text="底部" /><Slider x:Name="KeyBottomSlider" Tag="k_bottom" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="所选按键底部死区" />
                            <TextBlock x:Name="KeyBottomValue" HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ProfileEditorCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="快速触发 · 所选按键与批量设置" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="与自定义 DKS 互斥；按压、抬起灵敏度可独立设置。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="KeyRtFields" Spacing="6" HorizontalAlignment="Left">
                            <TextBlock x:Name="KeyRtSelectionText" TextWrapping="Wrap" />
                            <Button x:Name="ConfigureRtKeysButton" Click="ConfigureRtKeys_Click" HorizontalAlignment="Stretch">
                                <TextBlock Text="配置所选按键的快速触发" TextWrapping="Wrap" />
                            </Button>
                            <TextBlock x:Name="KeyRtSource" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="启用所选按键的快速触发" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="KeyRtEnabled" OnContent="开启" OffContent="关闭" AutomationProperties.Name="启用所选按键的快速触发"
                                          Toggled="KeyRtEnabled_Toggled" />
                            <InfoBar x:Name="RtDksAuthoringBar" Severity="Warning" IsOpen="False" IsClosable="False" />
                            <StackPanel Spacing="6">
                                <Button x:Name="SetRtKeysStandardButton" Click="SetRtKeysStandard_Click" HorizontalAlignment="Stretch">
                                    <TextBlock Text="将所选按键设为标准模式" TextWrapping="Wrap" />
                                </Button>
                                <Button x:Name="KeepDksDisableRtButton" Click="KeepDksDisableRt_Click" HorizontalAlignment="Stretch">
                                    <TextBlock Text="保留 DKS，关闭冲突按键的快速触发" TextWrapping="Wrap" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="这些操作仅修改配置文件草稿；保存不会写入键盘。标准模式会替换所选按键的 DKS 动作。" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                            <TextBlock Text="按压灵敏度" /><Slider x:Name="KeyPressSlider" Tag="k_press" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="所选按键快速触发按压灵敏度" />
                            <TextBlock x:Name="KeyPressValue" HorizontalAlignment="Right" />
                            <TextBlock Text="抬起灵敏度" /><Slider x:Name="KeyReleaseSlider" Tag="k_release" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="所选按键快速触发抬起灵敏度" />
                            <TextBlock x:Name="KeyReleaseValue" HorizontalAlignment="Right" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <controls:SettingsExpander x:Name="DksExpander" Header="动态按键 DKS" Description="四段动作与标准行为"
                                               IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8D4;" /></controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <Border Style="{StaticResource ProfileEditorCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="此键 DKS" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <StackPanel x:Name="DksFields" Spacing="8" HorizontalAlignment="Left">
                                    <ComboBox x:Name="DksMode" Header="行为" SelectionChanged="DksMode_SelectionChanged">
                                        <ComboBoxItem Content="不管理 DKS（不代表标准模式）" />
                                        <ComboBoxItem Content="标准按键行为" />
                                        <ComboBoxItem Content="自定义四段动作" />
                                    </ComboBox>
                                    <StackPanel x:Name="DksCustomPanel" Spacing="6">
                                        <TextBlock Text="起点" /><Slider x:Name="DksStartSlider" Tag="dks_start" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="DKS 起点" />
                                        <TextBlock x:Name="DksStartValue" HorizontalAlignment="Right" />
                                        <TextBlock Text="终点" /><Slider x:Name="DksEndSlider" Tag="dks_end" ValueChanged="ValueSlider_Changed" AutomationProperties.Name="DKS 终点" />
                                        <TextBlock x:Name="DksEndValue" HorizontalAlignment="Right" />
                                        <Grid x:Name="DksSlotsHost" RowSpacing="8" ColumnSpacing="8" />
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    </StackPanel>
                    <TextBlock Text="其他配置" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <controls:SettingsCard Header="关联的 Aura 灯效配置"
                                           Description="完整灯效联动将在后续版本加入。"
                                           IsClickEnabled="False">
                        <TextBlock x:Name="LightingReferenceText" Text="未关联" TextWrapping="Wrap" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="自动切换" Description="按前台程序配置匹配规则，自动激活对应配置文件。"
                                           IsClickEnabled="False">
                        <Button Content="管理程序规则" Click="Automation_Click" AutomationProperties.AutomationId="ProfileAutomationEditor" />
                    </controls:SettingsCard>
                </StackPanel>
                </ContentControl>

                <StackPanel x:Name="ContextPanel" Grid.Column="1" Spacing="12" Visibility="Collapsed">
                    <Border Padding="16" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="配置概览" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="ContextName" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ContextState" Text="—" TextWrapping="Wrap" />
                            <TextBlock x:Name="ContextOverrides" Text="逐键覆盖：0 个" TextWrapping="Wrap" />
                            <TextBlock Text="保存只更新配置；应用才会提交给键盘。"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Expander Header="应用详情" IsExpanded="False">
                        <TextBlock x:Name="ApplyDetailsText" Text="尚无应用记录" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Expander>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
