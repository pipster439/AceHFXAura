<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="24,20,24,24" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <!-- 宽屏视图 (窗口宽度 >= 680px) -->
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="680" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderActions.(Grid.Row)" Value="0" />
                            <Setter Target="HeaderActions.(Grid.Column)" Value="1" />
                            <Setter Target="HeaderActions.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="HeaderActions.Margin" Value="0" />
                            <Setter Target="HeaderActions.HorizontalAlignment" Value="Right" />
                            <Setter Target="SummaryCardCol1.Width" Value="Auto" />
                            <Setter Target="SummaryCardCol2.Width" Value="*" />
                            <Setter Target="SummaryFgPanel.(Grid.Row)" Value="0" />
                            <Setter Target="SummaryFgPanel.(Grid.Column)" Value="1" />
                            <Setter Target="SummaryRevPanel.(Grid.Row)" Value="0" />
                            <Setter Target="SummaryRevPanel.(Grid.Column)" Value="2" />
                            <Setter Target="SummaryRevPanel.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- 窄屏视图 (窗口宽度 < 680px，支持最小 500-600px 视口无裁切) -->
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="HeaderActions.(Grid.Row)" Value="1" />
                            <Setter Target="HeaderActions.(Grid.Column)" Value="0" />
                            <Setter Target="HeaderActions.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="HeaderActions.Margin" Value="0,12,0,0" />
                            <Setter Target="HeaderActions.HorizontalAlignment" Value="Left" />
                            <Setter Target="SummaryCardCol1.Width" Value="*" />
                            <Setter Target="SummaryCardCol2.Width" Value="0" />
                            <Setter Target="SummaryFgPanel.(Grid.Row)" Value="0" />
                            <Setter Target="SummaryFgPanel.(Grid.Column)" Value="1" />
                            <Setter Target="SummaryRevPanel.(Grid.Row)" Value="1" />
                            <Setter Target="SummaryRevPanel.(Grid.Column)" Value="0" />
                            <Setter Target="SummaryRevPanel.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 页面标题与顶部操作栏 -->
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4" Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="应用联动规则 (Automation)" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="基于 Windows 系统前台窗口事件驱动的智能方案切换：当目标程序在前台运行时自动激活指定灯效方案"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshBtn" Click="RefreshBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddRuleBtn" Click="AddRuleBtn_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="添加规则" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 状态提示栏 -->
            <InfoBar x:Name="PageInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational" />

            <!-- 加载中进度条 -->
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" />

            <!-- 规则统计与前台运行概览卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnSpacing="20" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SummaryCardCol0" Width="Auto" />
                        <ColumnDefinition x:Name="SummaryCardCol1" Width="Auto" />
                        <ColumnDefinition x:Name="SummaryCardCol2" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Text="已配置规则数" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="RuleCountText" Text="--" FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="SummaryFgPanel" Grid.Row="0" Grid.Column="1" Spacing="2">
                        <TextBlock Text="当前前台进程" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ForegroundProcText" Text="--" FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="SummaryRevPanel" Grid.Row="0" Grid.Column="2" Spacing="2">
                        <TextBlock Text="配置版本 (Revision)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ConfigRevisionText" Text="--" FontFamily="Consolas" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 空状态提示 (无规则时显示) -->
            <Border x:Name="EmptyStateCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE74C;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无应用联动规则" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="点击上方【添加规则】按钮，设置当指定程序进入前台时自动启用的灯效方案"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 规则列表容器 -->
            <ItemsControl x:Name="RulesListControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,8">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：程序与绑定方案 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Width="36"
                                            Height="36"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE756;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Process}" FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTipService.ToolTip="{Binding Process}" />
                                            <FontIcon Glyph="&#xE72A;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE790;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Profile}"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="130"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               ToolTipService.ToolTip="{Binding Profile}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="前台触发程序 -> 激活方案" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 右侧：操作按钮 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Tag="{Binding}" Click="EditRuleItem_Click" ToolTipService.ToolTip="编辑此规则">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                    </Button>
                                    <Button Tag="{Binding}" Click="DeleteRuleItem_Click" ToolTipService.ToolTip="删除此规则">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
