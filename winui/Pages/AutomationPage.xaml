<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="36,24,36,36">
            <StackPanel Spacing="4">
                <TextBlock Text="自动化与规则 (Automation)" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="基于 Windows 系统前台窗口事件驱动的智能方案匹配"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="前台监控机制 (Foreground Monitor)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="核心守护进程通过 Win32 SetWinEventHook(EVENT_SYSTEM_FOREGROUND) 进行纯事件驱动监听，完全无轮询开销。当检测到游戏或目标进程时，自动完成毫秒级灯效切换与 Web 服务节能管理。"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar Title="架构说明"
                     Message="现有 RuleEngine 与配置文件（config.json）在后台保持正常运作与热重载。原生规则配置表单将在后续阶段接入统一 Control API。"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
