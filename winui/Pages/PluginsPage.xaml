<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Aura_WinUI.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="PluginCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible"
                  HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Spacing="18" MaxWidth="1200" HorizontalAlignment="Center">

            <!-- 页头 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="插件与扩展" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="统一管理 Aura 原生灯效插件与外部模拟外设生态桥接，保持主程序轻量解耦"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="OpenPluginsFolderBtn" Click="OpenPluginsFolderBtn_Click"
                            AutomationProperties.AutomationId="PluginsOpenDir">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="打开 plugins 目录" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RescanPluginsBtn" Click="RescanPluginsBtn_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="PluginsRescan">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="重新扫描" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="PluginsNoticeBar" IsOpen="False" IsClosable="True" Severity="Informational" />

            <!-- 分区 1: 外部生态桥接 (Wooting Analog SDK) -->
            <StackPanel Spacing="10">
                <TextBlock Text="外部生态桥接" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border Style="{StaticResource PluginCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA86;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="WootingTitleText" Text="Wooting Analog SDK 桥接 (M605)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="WootingDescText"
                                           Text="通过共享内存把 ROG Falchion Ace HFX 映射为 Wooting 模拟键盘设备，零 HID 句柄冲突。"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton x:Name="WootingHallToggle" Grid.Column="2"
                                          Click="WootingHallToggle_Click"
                                          Content="开启共享内存广播"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AutomationId="PluginsWootingHallToggle" />
                        </Grid>

                        <!-- 状态徽章行 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="WootingBuiltText" Text="编译产物：检测中" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="WootingInstalledText" Text="系统安装：检测中" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="WootingShmText" Text="共享内存：检测中" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>

                        <CheckBox x:Name="WootingUnlockFaCheckBox"
                                  Content="兼容未打补丁原厂固件 (FA 00 / FA 10 免补丁开流)" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="InstallWootingBtn"
                                    Content="安装到 Wooting 插件目录（管理员）"
                                    Click="InstallWootingBtn_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="PluginsWootingInstall" />
                            <Button x:Name="OpenWootingSourceBtn"
                                    Content="打开桥接工程目录"
                                    Click="OpenWootingSourceBtn_Click" />
                        </StackPanel>

                        <controls:SettingsExpander Header="怎么玩 Wooting 插件生态？"
                                                   Description="展开查看如何把磁轴当作手柄线性摇杆/油门或配合 OBS 显示按压深度"
                                                   IsExpanded="False">
                            <controls:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE946;" />
                            </controls:SettingsExpander.HeaderIcon>
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard IsClickEnabled="False" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="1. 点击上方“安装到 Wooting 插件目录（管理员）”，将编译好的 DLL 安装至 C:\Program Files\WootingAnalogPlugins\。" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Text="2. 打开“开启共享内存广播”（或在磁轴设置页打开“实时行程”），Aura 会将 68 颗按键以标准 USB HID 键码实时写入 Local\AuraM605HallAnalogV1。" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock Text="3. 打开 Universal Analog Controller（把 A/D/W/S 映射为 Xbox 左摇杆与扳机油门刹车）、支持 Wooting Analog SDK 的游戏或 OBS 深度叠加插件即可直接使用。" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                    </StackPanel>
                </Border>

                <!-- Aura MCP 外部 AI 接入服务卡片 -->
                <Border Style="{StaticResource PluginCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE968;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="McpTitleText" Text="Aura MCP 外部接入服务" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="McpDescText"
                                           Text="替代 Studio 内置 AI 助手：通过标准 stdio MCP 协议把灯效编排、IR/C++ 编译、键位映射与霍尔遥测暴露给外部 AI 客户端。"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="McpReadyText" Text="服务脚本：检测中" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="McpTransportText" Text="传输协议：stdio (JSON-RPC 2.0)" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CopyMcpConfigBtn"
                                    Content="复制 MCP 客户端配置"
                                    Click="CopyMcpConfigBtn_Click"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="PluginsMcpCopyConfig" />
                            <Button x:Name="OpenMcpFolderBtn"
                                    Content="打开 MCP 目录"
                                    Click="OpenMcpFolderBtn_Click"
                                    AutomationProperties.AutomationId="PluginsMcpOpenDir" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 分区 2: Aura 原生插件 (plugins/) -->
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="Aura 原生光效插件" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="NativePluginCountText"
                               Text="0 个已加载"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <TextBlock Text="支持 ABI v1 原生 C++ DLL 与 Studio 积木程序 (.aurair)；扩展插件可通过 AuraBindHallAnalog 实时读取 68 键霍尔压感。"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="NativePluginsList" Spacing="8" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
