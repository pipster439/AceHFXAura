<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Padding="36,24,36,36" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="设置 (Settings)" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="配置客户端偏好、视窗行为与服务状态"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 外观与主题 -->
            <StackPanel Spacing="12">
                <TextBlock Text="外观 (Appearance)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="应用主题" FontWeight="SemiBold" />
                            <TextBlock Text="选择浅色、深色或跟随 Windows 系统设置"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeComboBox"
                                  Grid.Column="1"
                                  Width="140"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="Default" />
                            <ComboBoxItem Content="浅色 (Light)" Tag="Light" />
                            <ComboBoxItem Content="深色 (Dark)" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 视窗与生命周期行为 -->
            <StackPanel Spacing="12">
                <TextBlock Text="生命周期与托盘 (Lifecycle)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="关闭窗口时最小化至托盘" FontWeight="SemiBold" />
                            <TextBlock Text="点击窗口关闭按钮时保留后台常驻，不中断键盘灯效与前台感知"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                      Grid.Column="1"
                                      IsOn="True"
                                      Toggled="MinimizeToTrayToggle_Toggled"
                                      OnContent="开"
                                      OffContent="关" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 核心服务控制 -->
            <StackPanel Spacing="12">
                <TextBlock Text="后台核心服务 (Daemon)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="守护进程运行状态" FontWeight="SemiBold" />
                                <TextBlock x:Name="DaemonStatusDetailText"
                                           Text="正在检测..."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="RestartDaemonBtn"
                                    Grid.Column="1"
                                    Content="重新连接"
                                    Click="RestartDaemonBtn_Click" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="本地 Web 端口" FontWeight="SemiBold" />
                                <TextBlock Text="http://127.0.0.1:19898 (可使用外部浏览器访问或作为 LAN 调试)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="OpenBrowserBtn"
                                    Grid.Column="1"
                                    Content="在浏览器中打开"
                                    Click="OpenBrowserBtn_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于信息 -->
            <StackPanel Spacing="12">
                <TextBlock Text="关于 (About)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="AceHFXAura WinUI 3 Desktop Client" FontWeight="SemiBold" />
                        <TextBlock Text="版本: v0.1.0-alpha.2 (Phase 1 Shell)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="专为 ASUS ROG Falchion Ace HFX 打造的原生桌面客户端与磁轴灯效生态"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
