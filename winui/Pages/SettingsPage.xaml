<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Aura_WinUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      Background="Transparent">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Spacing="20" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="配置客户端偏好、窗口行为与服务状态" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Grid x:Name="SettingsColumns" ColumnSpacing="20">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
              <StackPanel x:Name="SettingsMain" Spacing="20" MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="外观" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <controls:SettingsCard Header="应用主题" Description="选择浅色、深色或跟随系统" IsClickEnabled="False">
                    <controls:SettingsCard.HeaderIcon><SymbolIcon Symbol="View" /></controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeComboBox" MinWidth="140" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="跟随系统" Tag="Default" />
                        <ComboBoxItem Content="浅色" Tag="Light" />
                        <ComboBoxItem Content="深色" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="应用行为" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <controls:SettingsCard Header="关闭窗口时最小化至托盘" Description="保留后台服务，继续运行灯效与前台感知" IsClickEnabled="False">
                    <controls:SettingsCard.HeaderIcon><SymbolIcon Symbol="DockBottom" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="MinimizeToTrayToggle" IsOn="True" OnContent="开" OffContent="关" Toggled="MinimizeToTrayToggle_Toggled" />
                </controls:SettingsCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="核心服务" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <controls:SettingsExpander x:Name="CoreSettingsExpander" Header="服务状态" Description="查看连接状态和运行时信息" IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon><SymbolIcon Symbol="World" /></controls:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="DaemonStatusDetailText" Text="正在检测…" TextWrapping="Wrap" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="工作室状态" Description="嵌入式编辑器服务" IsClickEnabled="False">
                            <TextBlock x:Name="StudioStatusText" Text="工作室：正在检测…" TextWrapping="Wrap" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="配置健康状态" Description="当前生效配置" IsClickEnabled="False">
                            <TextBlock x:Name="ConfigHealthText" Text="正在检测…" TextWrapping="Wrap" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="运行时详细信息" Description="核心版本、进程与配置路径" IsClickEnabled="False">
                            <TextBlock x:Name="RuntimeDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="浏览器入口" Description="在默认浏览器中打开本机工作室" IsClickEnabled="False">
                            <Button x:Name="OpenBrowserBtn" Content="在浏览器中打开" Click="OpenBrowserBtn_Click" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsCard Header="重新连接" Description="重新连接本机核心服务" IsClickEnabled="False">
                    <Button x:Name="RestartDaemonBtn" Content="重新连接" Click="RestartDaemonBtn_Click" />
                </controls:SettingsCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock Text="关于" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <controls:SettingsCard Header="Aura" Description="专为 ASUS ROG Falchion Ace HFX 打造的灯效与自动化客户端" IsClickEnabled="False">
                    <controls:SettingsCard.HeaderIcon><SymbolIcon Symbol="Help" /></controls:SettingsCard.HeaderIcon>
                    <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
                </controls:SettingsCard>
            </StackPanel>
              </StackPanel>
              <StackPanel x:Name="SettingsAside" Grid.Column="1" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="运行概览" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <controls:SettingsCard Header="核心服务" Description="当前连接">
                  <TextBlock x:Name="AsideCoreText" Text="正在检测…" TextWrapping="Wrap" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="工作室" Description="编辑器服务">
                  <TextBlock x:Name="AsideStudioText" Text="正在检测…" TextWrapping="Wrap" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="配置" Description="核心正在使用的配置路径">
                  <StackPanel Spacing="4">
                    <TextBlock x:Name="AsideConfigHealthText" Text="正在检测…" TextWrapping="Wrap" />
                    <TextBlock x:Name="AsideConfigText" Text="尚未取得核心信息" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  </StackPanel>
                </controls:SettingsCard>
              </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
