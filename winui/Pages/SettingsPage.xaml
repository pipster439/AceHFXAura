<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Spacing="20" MaxWidth="1200" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="设置 (Settings)" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="配置客户端偏好、视窗行为与服务状态"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 外观与主题 -->
            <StackPanel Spacing="10">
                <TextBlock Text="外观 (Appearance)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="应用主题" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="选择浅色、深色或跟随 Windows 系统设置"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="ThemeControlContainer" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBox x:Name="ThemeComboBox"
                                      Width="140"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="Default" />
                                <ComboBoxItem Content="浅色 (Light)" Tag="Light" />
                                <ComboBoxItem Content="深色 (Dark)" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 视窗与生命周期行为 -->
            <StackPanel Spacing="10">
                <TextBlock Text="生命周期与托盘 (Lifecycle)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="关闭窗口时最小化至托盘" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="点击窗口右上角关闭按钮时保留后台常驻，不中断键盘灯效与前台感知"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="TrayControlContainer" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                          IsOn="True"
                                          Toggled="MinimizeToTrayToggle_Toggled"
                                          OnContent="开"
                                          OffContent="关" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 核心服务控制 -->
            <StackPanel Spacing="10">
                <TextBlock Text="后台核心服务 (Daemon)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="守护进程运行状态" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DaemonStatusDetailText"
                                           Text="正在检测..."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="DaemonControlContainer" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="RestartDaemonBtn"
                                        Content="重新连接"
                                        Click="RestartDaemonBtn_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="StudioStatusText" Text="Studio：正在检测…" TextWrapping="Wrap"/>
                        <Expander Header="运行时详细信息" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBlock x:Name="RuntimeDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </Expander>
                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Studio 浏览器入口" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="在默认浏览器中打开本机 Studio"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="BrowserControlContainer" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="OpenBrowserBtn"
                                        Content="在浏览器中打开"
                                        Click="OpenBrowserBtn_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于信息 -->
            <StackPanel Spacing="10">
                <TextBlock Text="关于 (About)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="AceHFXAura WinUI 3 Desktop Client" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="专为 ASUS ROG Falchion Ace HFX 打造的原生桌面客户端与磁轴灯效生态"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
