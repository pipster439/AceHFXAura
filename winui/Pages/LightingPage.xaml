<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
    <ScrollViewer x:Name="LightingContent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="PageContent" Spacing="20" MaxWidth="1200" HorizontalAlignment="Left">
            <!-- 页面标题 -->
            <StackPanel Spacing="4">
                <TextBlock Text="灯效管理 (Lighting)" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="基础灯效预设与渲染参数调控"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="16">
             <TextBlock Text="当前灯效状态" Style="{ThemeResource SubtitleTextBlockStyle}"/>
             <Grid x:Name="LightingStatusGrid" ColumnSpacing="20" RowSpacing="16">
              <StackPanel Spacing="4"><TextBlock Text="设备连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="DeviceStateText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="默认灯效" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="DefaultEffectText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="当前运行方案" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="ActiveProfileText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="当前目标刷新率" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="ActiveFpsText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="刷新率来源" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="FpsSourceText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Spacing="4"><TextBlock Text="硬件接口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="ActiveBackendText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
             </Grid>
             <Button x:Name="RefreshStatusBtn" Content="刷新状态" Click="RefreshStatusBtn_Click"/>
             <InfoBar x:Name="StatusMismatchInfoBar" IsOpen="False" IsClosable="False" Severity="Informational"/>
            </StackPanel></Border>
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="10">
             <TextBlock Text="全局默认刷新率" Style="{ThemeResource SubtitleTextBlockStyle}"/>
             <TextBlock x:Name="GlobalFpsText" Text="正在读取…" FontWeight="SemiBold"/>
             <TextBlock Text="适用于继承全局设置的方案；独立设置刷新率的方案不受影响。范围 10–100 FPS，默认参考值 25 FPS。" TextWrapping="Wrap"/>
             <Button x:Name="GlobalFpsButton" Content="设置全局刷新率…" Click="GlobalFps_Click"/>
            </StackPanel></Border>
            <InfoBar x:Name="AdvancedEffectBanner" IsOpen="False" IsClosable="False" Severity="Warning" Title="当前默认方案由 Studio 管理"><InfoBar.ActionButton><Button Content="打开 Studio" Click="OpenStudioBtn_Click"/></InfoBar.ActionButton></InfoBar>
            <!-- 5. 预设灯效选择卡片 (Builtin Presets) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="预设灯效 (Builtin Presets)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="选择系统内置的标准动态与静态光效预设；选择后将在下方加载规范参数"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 预设卡片列表 -->
                    <GridView x:Name="PresetsGridView"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              SelectionChanged="PresetsGridView_SelectionChanged">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Width="160"
                                        Height="68"
                                        Padding="12,8">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Effect}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>

            <!-- 6. 基础灯效参数调控卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="参数调控 (Parameters)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="调整本地草稿，点击“应用更改”后写入系统默认配置，无需重启守护进程"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 选中预设概要 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="选中预设" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SelectedPresetText"
                                   Text="--"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 亮度调节 (0 - 100%) -->
                    <StackPanel x:Name="BrightnessPanel" Spacing="4" HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="亮度 (Brightness)" Style="{ThemeResource BodyStrongTextBlockStyle}" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock x:Name="BrightnessValueText" Width="64" TextAlignment="Right" Text="100%" Style="{ThemeResource BodyStrongTextBlockStyle}" Grid.Column="1" TextWrapping="NoWrap" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="BrightnessSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                HorizontalAlignment="Stretch"
                                ValueChanged="BrightnessSlider_ValueChanged" />
                        <TextBlock Text="调节默认灯效的整体发光亮度 (0%–100%)"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 动画周期 (仅当 supports_period == true 时显示) -->
                    <StackPanel x:Name="PeriodPanel" Spacing="6" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <TextBlock Text="动画周期 (Animation Period)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <NumberBox x:Name="PeriodNumberBox"
                                   Minimum="33"
                                   SmallChange="100"
                                   LargeChange="500"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="PeriodNumberBox_ValueChanged" />
                        <TextBlock Text="动态效果单次循环周期 (毫秒，最小 33ms)"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 动态参数调控区 (由 Builtin Preset Parameter Schema 动态生成) -->
                    <StackPanel x:Name="DynamicParametersPanel" Spacing="16" HorizontalAlignment="Stretch" Visibility="Collapsed" />

                    <!-- 底部操作栏 -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="SaveBtn"
                                Content="应用更改"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="SaveBtn_Click"
                                IsEnabled="False" />
                        <TextBlock x:Name="DirtyHintText"
                                   Text="存在未保存的修改"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    <InfoBar x:Name="StatusInfoBar" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="1100" Margin="24,12,40,0" IsOpen="False" IsClosable="True"/>
    </Grid>
</Page>
