{
  "default_profile": "desktop",
  "fps": 25,
  "hardware_backend": "auto",
  "profiles": {
    "desktop": {
      "type": "static",
      "color": [
        0,
        80,
        200
      ]
    },
    "cs2_gamer": {
      "type": "breathing",
      "color1": [
        255,
        100,
        0
      ],
      "color2": [
        50,
        10,
        0
      ],
      "period_ms": 2500
    },
    "coding": {
      "type": "static",
      "color": [
        0,
        255,
        128
      ]
    }
  },
  "rules": [
    {
      "process": "cs2.exe",
      "profile": "cs2_gamer",
      "custom_extra_tag": "keep_intact",
      "suppress_web_ui": true
    },
    {
      "process": "devenv.exe",
      "profile": "coding",
      "suppress_web_ui": false
    }
  ]
}
