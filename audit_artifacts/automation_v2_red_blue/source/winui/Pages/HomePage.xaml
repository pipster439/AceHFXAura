<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RootPanel" Spacing="20" Padding="24,20,24,24">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <!-- 宽屏视图：双列布局 (窗口宽度 >= 720px) -->
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CardGridCol1.Width" Value="*" />
                            <Setter Target="DeviceCard.(Grid.Row)" Value="0" />
                            <Setter Target="DeviceCard.(Grid.Column)" Value="0" />
                            <Setter Target="DaemonCard.(Grid.Row)" Value="0" />
                            <Setter Target="DaemonCard.(Grid.Column)" Value="1" />
                            <Setter Target="ProfileCard.(Grid.Row)" Value="1" />
                            <Setter Target="ProfileCard.(Grid.Column)" Value="0" />
                            <Setter Target="GsiCard.(Grid.Row)" Value="1" />
                            <Setter Target="GsiCard.(Grid.Column)" Value="1" />
                            <Setter Target="QuickCard.(Grid.Row)" Value="2" />
                            <Setter Target="QuickCard.(Grid.Column)" Value="0" />
                            <Setter Target="QuickCard.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- 窄屏视图：单列平铺 (窗口宽度 < 720px，完全兼容 600 DIP 最小物理约束) -->
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="CardGridCol1.Width" Value="0" />
                            <Setter Target="DeviceCard.(Grid.Row)" Value="0" />
                            <Setter Target="DeviceCard.(Grid.Column)" Value="0" />
                            <Setter Target="DaemonCard.(Grid.Row)" Value="1" />
                            <Setter Target="DaemonCard.(Grid.Column)" Value="0" />
                            <Setter Target="ProfileCard.(Grid.Row)" Value="2" />
                            <Setter Target="ProfileCard.(Grid.Column)" Value="0" />
                            <Setter Target="GsiCard.(Grid.Row)" Value="3" />
                            <Setter Target="GsiCard.(Grid.Column)" Value="0" />
                            <Setter Target="QuickCard.(Grid.Row)" Value="4" />
                            <Setter Target="QuickCard.(Grid.Column)" Value="0" />
                            <Setter Target="QuickCard.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 标题区 -->
            <StackPanel Spacing="4">
                <TextBlock Text="ROG Falchion Ace HFX 控制中心" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="硬件级单键 RGB 磁轴键盘控制与生态协同平台"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 状态卡片响应式网格 -->
            <Grid x:Name="CardGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CardGridCol0" Width="*" />
                    <ColumnDefinition x:Name="CardGridCol1" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. 设备状态卡片 -->
                <Border x:Name="DeviceCard"
                        Grid.Row="0" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE765;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="ROG Falchion Ace HFX" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="DeviceStatusText"
                                           Text="正在检测..."
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="BackendStatusText"
                                   Text="后端协议: 检测中..."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 2. 守护进程状态卡片 -->
                <Border x:Name="DaemonCard"
                        Grid.Row="0" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEC05;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="核心服务 (daemon)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="DaemonStatusText" Text="正在检测..." Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="DaemonDetailText"
                                   Text="正在连接 Control API (127.0.0.1:19897)..."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 3. 方案与渲染卡片 -->
                <Border x:Name="ProfileCard"
                        Grid.Row="1" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE706;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="当前灯效方案" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="ActiveProfileText" Text="--" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="FpsText"
                                   Text="渲染帧率: --"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 4. 游戏集成卡片 -->
                <Border x:Name="GsiCard"
                        Grid.Row="1" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7FC;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="游戏联动 (CS2 GSI)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="GsiStatusText" Text="Idle" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="炸弹倒计时、血量呼吸、击杀瞬态光效同步中"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 5. 快捷入口卡片 -->
                <Border x:Name="QuickCard"
                        Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快捷入口" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenStudioBtn"
                                    Grid.Column="0"
                                    Click="OpenStudioBtn_Click"
                                    AutomationProperties.Name="进入 Blockly Studio"
                                    ToolTipService.ToolTip="进入 Blockly Studio"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE943;" FontSize="16" />
                                    <TextBlock Text="进入 Blockly Studio" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RefreshStatusBtn"
                                    Grid.Column="1"
                                    Click="RefreshStatusBtn_Click"
                                    AutomationProperties.Name="刷新核心状态"
                                    ToolTipService.ToolTip="刷新核心状态">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                    <TextBlock Text="刷新核心状态" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 状态通道指引 -->
            <InfoBar Title="Aura Control API v1 已接入"
                     Message="本页面已通过 daemon 核心端口 (http://127.0.0.1:19897/api/runtime/status) 实时同步真实设备连接、协议通道、活跃方案与推流帧率。"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Success" />
        </StackPanel>
    </ScrollViewer>
</Page>
