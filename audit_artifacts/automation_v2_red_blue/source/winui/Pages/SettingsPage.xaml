<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="24,20,24,24" MaxWidth="860" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="SettingsWide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="640" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <!-- 窄窗口状态 (600 DIP 或收起模式)：设置行操作控件允许下沉重排，防止挤压文字与横向滚动 -->
                    <VisualState x:Name="SettingsNarrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ThemeControlContainer.(Grid.Row)" Value="1" />
                            <Setter Target="ThemeControlContainer.(Grid.Column)" Value="0" />
                            <Setter Target="ThemeControlContainer.HorizontalAlignment" Value="Left" />
                            <Setter Target="TrayControlContainer.(Grid.Row)" Value="1" />
                            <Setter Target="TrayControlContainer.(Grid.Column)" Value="0" />
                            <Setter Target="TrayControlContainer.HorizontalAlignment" Value="Left" />
                            <Setter Target="DaemonControlContainer.(Grid.Row)" Value="1" />
                            <Setter Target="DaemonControlContainer.(Grid.Column)" Value="0" />
                            <Setter Target="DaemonControlContainer.HorizontalAlignment" Value="Left" />
                            <Setter Target="BrowserControlContainer.(Grid.Row)" Value="1" />
                            <Setter Target="BrowserControlContainer.(Grid.Column)" Value="0" />
                            <Setter Target="BrowserControlContainer.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel Spacing="4">
                <TextBlock Text="设置 (Settings)" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="配置客户端偏好、视窗行为与服务状态"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 外观与主题 -->
            <StackPanel Spacing="10">
                <TextBlock Text="外观 (Appearance)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="应用主题" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="选择浅色、深色或跟随 Windows 系统设置"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="ThemeControlContainer" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBox x:Name="ThemeComboBox"
                                      Width="140"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="Default" />
                                <ComboBoxItem Content="浅色 (Light)" Tag="Light" />
                                <ComboBoxItem Content="深色 (Dark)" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 视窗与生命周期行为 -->
            <StackPanel Spacing="10">
                <TextBlock Text="生命周期与托盘 (Lifecycle)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="关闭窗口时最小化至托盘" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="点击窗口右上角关闭按钮时保留后台常驻，不中断键盘灯效与前台感知"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="TrayControlContainer" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                          IsOn="True"
                                          Toggled="MinimizeToTrayToggle_Toggled"
                                          OnContent="开"
                                          OffContent="关" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 核心服务控制 -->
            <StackPanel Spacing="10">
                <TextBlock Text="后台核心服务 (Daemon)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="守护进程运行状态" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DaemonStatusDetailText"
                                           Text="正在检测..."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="DaemonControlContainer" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="RestartDaemonBtn"
                                        Content="重新连接"
                                        Click="RestartDaemonBtn_Click" />
                            </StackPanel>
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="本地 Web 调试端口" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="http://127.0.0.1:19898 (本机回环 loopback 调试访问)"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="BrowserControlContainer" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="OpenBrowserBtn"
                                        Content="在浏览器中打开"
                                        Click="OpenBrowserBtn_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于信息 -->
            <StackPanel Spacing="10">
                <TextBlock Text="关于 (About)" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="AceHFXAura WinUI 3 Desktop Client" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="版本: v0.1.0-alpha.2 (Phase 1 Shell)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="专为 ASUS ROG Falchion Ace HFX 打造的原生桌面客户端与磁轴灯效生态"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
