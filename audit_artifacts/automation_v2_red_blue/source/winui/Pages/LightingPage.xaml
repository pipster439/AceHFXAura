<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aura_WinUI.Pages.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Padding="24,20,24,24" HorizontalAlignment="Stretch">
            <!-- 页面标题 -->
            <StackPanel Spacing="4">
                <TextBlock Text="灯效管理 (Lighting)" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="基础灯效预设与渲染参数调控"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 1. 当前运行态卡片 (来自 /api/lighting/base 与 /api/runtime/status) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="灯效状态" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="默认基础灯效配置与当前设备实时渲染方案"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="1"
                            x:Name="RefreshStatusBtn"
                            Click="RefreshStatusBtn_Click"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新状态" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="24" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="默认基础灯效" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DefaultEffectText" Text="正在读取..." FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="当前运行方案" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ActiveProfileText" Text="正在读取..." FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="推流帧率" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ActiveFpsText" Text="--" FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="硬件接口" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ActiveBackendText" Text="--" FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. 中性事实运行状态提示条 (active != base 时展开) -->
            <InfoBar x:Name="StatusMismatchInfoBar"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Informational" />

            <!-- 3. 高级方案警告与 Studio 引导卡片 (default_profile 为 custom_keymap/plugin 时展示) -->
            <InfoBar x:Name="AdvancedEffectBanner"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Warning"
                     Title="当前默认方案为高级效果 (Studio 管理)">
                <InfoBar.ActionButton>
                    <Button Content="打开 Studio" Click="OpenStudioBtn_Click" Style="{ThemeResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- 4. 通知提示条 (保存成功 / 409 冲突 / 错误提示) -->
            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="True" />

            <!-- 5. 预设灯效选择卡片 (Builtin Presets) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="预设灯效 (Builtin Presets)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="选择系统内置的标准动态与静态光效预设；选择后将在下方加载规范参数"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 预设卡片列表 -->
                    <GridView x:Name="PresetsGridView"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              SelectionChanged="PresetsGridView_SelectionChanged">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Width="160"
                                        Height="68"
                                        Padding="12,8">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Effect}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>

            <!-- 6. 基础灯效参数调控卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="参数调控 (Parameters)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="调整本地草稿，点击“应用更改”后写入系统默认配置，无需重启守护进程"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 选中预设概要 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="选中预设" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SelectedPresetText"
                                   Text="--"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 亮度调节 (0 - 100%) -->
                    <StackPanel Spacing="4" MaxWidth="540" HorizontalAlignment="Left">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="亮度 (Brightness)" Style="{ThemeResource BodyStrongTextBlockStyle}" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock x:Name="BrightnessValueText" Text="100%" Style="{ThemeResource BodyStrongTextBlockStyle}" Grid.Column="1" TextWrapping="NoWrap" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="BrightnessSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                HorizontalAlignment="Stretch"
                                ValueChanged="BrightnessSlider_ValueChanged" />
                        <TextBlock Text="调节默认灯效的整体发光亮度 (0%–100%)"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 动画周期 (仅当 supports_period == true 时显示) -->
                    <StackPanel x:Name="PeriodPanel" Spacing="6" MaxWidth="540" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock Text="动画周期 (Animation Period)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <NumberBox x:Name="PeriodNumberBox"
                                   Minimum="33"
                                   SmallChange="100"
                                   LargeChange="500"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="PeriodNumberBox_ValueChanged" />
                        <TextBlock Text="动态效果单次循环周期 (毫秒，最小 33ms)"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 动态参数调控区 (由 Builtin Preset Parameter Schema 动态生成) -->
                    <StackPanel x:Name="DynamicParametersPanel" Spacing="16" MaxWidth="540" HorizontalAlignment="Left" Visibility="Collapsed" />

                    <!-- 底部操作栏 -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="SaveBtn"
                                Content="应用更改"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="SaveBtn_Click"
                                IsEnabled="False" />
                        <TextBlock x:Name="DirtyHintText"
                                   Text="存在未保存的修改"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
