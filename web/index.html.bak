// 状态变量
let currentConfig = null;
let currentProfileName = 'desktop';
let isMasterLightOn = true;
let currentEffect = 'wave'; // 默认彩虹波浪
let colorMode = 'style';    // style 或 random
let currentPresetTheme = 'default';
let gradientStops = JSON.parse(JSON.stringify(GRADIENT_PRESETS.default));
let selectedStopId = 1;
// 用户「模拟触发」开关意图，跨灯效切换保留（仅作偏好记忆，不代表当前生效）
let isAnalogEnabled = false;
let brightnessVal = 1.0;    // 0.0 ~ 1.0
let speedIndex = 2;         // 0: 慢, 1: 正常, 2: 快 (默认快)
let currentDirection = 'diag_dl'; // 默认左下 ◣
let thicknessVal = 1.0;

// 键盘元素引用与动画参数
let keyElements = [];
let reactiveDecays = {};
let analogDecays = {};      // 常亮类模拟灯效按压增亮 (仅 static 使用)
let activeRipples = [];
let lastUserKeystrokeTime = performance.now();

// ========================================================
// 6. 页面初始化
// ========================================================
window.addEventListener('DOMContentLoaded', () => {
    buildVirtualKeyboard();
    renderGradientStops();
    updateCyberCardUI();
    loadConfig();
    startHeartbeat();
    requestAnimationFrame(renderLightingLoop);
});

// 构建符合 ASUS 尺寸规格与 class 规范的虚拟键盘 DOM
function buildVirtualKeyboard() {
    const baseLayer = document.getElementById('keyboard-base-layer');
    baseLayer.innerHTML = '';
    keyElements = [];

    const unitWidth = 51.75;
    const gap = 4;

    KEYBOARD_LAYOUT.forEach((rowKeys, rowIndex) => {
        const rowDiv = document.createElement('div');
        rowDiv.className = 'device-keyboard-module__keyboard-row';

        let colOffset = 0;
        rowKeys.forEach((keyData) => {
            const keyDiv = document.createElement('div');
            keyDiv.className = 'device-keyboard-module__key';
            keyDiv.setAttribute('data-key', keyData.name);
            keyDiv.setAttribute('data-row', rowIndex);
            keyDiv.setAttribute('data-col', colOffset);

            const calculatedWidth = (keyData.width * unitWidth) + ((keyData.width - 1) * gap);
            keyDiv.style.width = calculatedWidth + 'px';

            const labelSpan = document.createElement('span');
            labelSpan.className = 'key-label';
            labelSpan.textContent = keyData.label;
            keyDiv.appendChild(labelSpan);

            if (keyData.sub) {
                const subSpan = document.createElement('span');
                subSpan.className = 'key-sublabel';
                subSpan.textContent = keyData.sub;
                keyDiv.appendChild(subSpan);
            }

            // 敲击或点击触发按键交互
            keyDiv.onmousedown = (e) => {
                e.preventDefault();
                triggerKeyReactive(keyData.name, false);
            };
            keyDiv.onmouseup = () => releaseKeyReactive(keyData.name);
            keyDiv.onmouseleave = () => releaseKeyReactive(keyData.name);
            keyDiv.ontouchstart = (e) => {
                e.preventDefault();
                triggerKeyReactive(keyData.name, false);
            };
            keyDiv.ontouchend = () => releaseKeyReactive(keyData.name);

            rowDiv.appendChild(keyDiv);
            keyElements.push({
                el: keyDiv,
                name: keyData.name,
                row: rowIndex,
                col: colOffset,
                width: keyData.width
            });

            colOffset += keyData.width;
        });

        baseLayer.appendChild(rowDiv);
    });
}

// ========================================================
// 7. 灯效选择与界面自适应调控
// ========================================================
function selectEffect(effId) {
    currentEffect = effId;

    // 更新左侧列表状态
    document.querySelectorAll('.effect-item').forEach(el => {
        el.classList.remove('active', 'active-cyan');
        if (el.getAttribute('data-id') === effId) {
            if (effId === 'starry_night') {
                el.classList.add('active-cyan'); // 星空使用青色高亮 (参考图 3)
            } else {
                el.classList.add('active');      // 其他使用经典 ROG 红 (参考图 1)
            }
        }
    });

    updateCyberCardUI();

    // 模拟触发仅属于常亮类灯效。此处只隐藏开关并让持久化值写为 false，
    // 但**不清空** isAnalogEnabled —— 它是用户的偏好记忆，切回常亮时应自动恢复，
    // 否则「常亮(开) -> 涟漪 -> 常亮」会把用户设置悄悄丢掉。
    saveCurrentInputsToProfile();

    if (effId === 'reactive' || effId === 'ripple') {
        // 键盘响应型灯效：仅等待真实物理敲击/虚拟键点击，不做任何模拟自动触发
        const badge = document.getElementById('stage-badge');
        if (badge) {
            badge.innerHTML = '● <b>按键响应就绪</b>：敲击键盘任意键或点击虚拟键帽激荡光晕与涟漪！';
            badge.style.color = 'var(--rog-cyan)';
        }
    }
}

// 依据选中的灯效动态调整右侧参数卡片项的可见性
function updateCyberCardUI() {
    const isRainbow = (currentEffect === 'wave');
    const isStarry = (currentEffect === 'starry_night');
    const isQuicksand = (currentEffect === 'quicksand');
    const isCurrent = (currentEffect === 'current');
    const isRaindrop = (currentEffect === 'raindrop');
    const isStatic = (currentEffect === 'static');
    const isBreathing = (currentEffect === 'breathing');
    const isReactive = (currentEffect === 'reactive' || currentEffect === 'ripple');

    // 1. 颜色模式 (样式 / 随机) 仅在 星空 / 流沙 模式下展示
    document.getElementById('color-radio-row').style.display = (isStarry || isQuicksand) ? 'flex' : 'none';

    // 2. 模拟灯效组件 (仅在 恒亮/常亮 类灯效可见；键盘响应型灯效不提供模拟触发)
    document.getElementById('param-group-analog').style.display = (isStatic) ? 'flex' : 'none';

    // 3. 方向选择罗盘 (仅在 彩虹 / 流沙 / 电流 模式可见)
    document.getElementById('param-group-direction').style.display = (isRainbow || isQuicksand || isCurrent) ? 'flex' : 'none';

    // 4. 粗细调节 (仅在 彩虹 / 电流 模式可见)
    document.getElementById('param-group-thickness').style.display = (isRainbow || isCurrent) ? 'flex' : 'none';

    // 5. 速度调节 (恒亮无速度，其余均有)
    document.getElementById('param-group-speed').style.display = (isStatic) ? 'none' : 'flex';
}

// ========================================================
// 8. 赛博控件交互 (拨码开关、色标条、罗盘、滑条)
// ========================================================
function toggleMasterLight() {
    isMasterLightOn = !isMasterLightOn;
    const sw = document.getElementById('master-light-switch');
    if (isMasterLightOn) {
        sw.classList.add('on');
        sw.querySelector('.cyber-switch-text').textContent = 'ON';
    } else {
        sw.classList.remove('on');
        sw.querySelector('.cyber-switch-text').textContent = 'OFF';
    }
}

function setAnalogSwitchUI(on) {
    const sw = document.getElementById('analog-switch');
    if (sw) {
        if (on) { sw.classList.add('on'); } else { sw.classList.remove('on'); }
        const txt = sw.querySelector('.cyber-switch-text');
        if (txt) txt.textContent = on ? 'ON' : 'OFF';
    }
}

// 模拟触发是否「当前真正生效」：仅常亮类灯效下生效。
// 渲染与预览一律以此为准，而不是直接用 isAnalogEnabled。
function analogActive() {
    return (currentEffect === 'static') && isAnalogEnabled;
}

function toggleAnalogSwitch() {
    isAnalogEnabled = !isAnalogEnabled;
    setAnalogSwitchUI(isAnalogEnabled);
}

// 方向控制
function setDirection(dir) {
    currentDirection = dir;
    document.querySelectorAll('.dir-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-dir') === dir);
    });
    saveCurrentInputsToProfile();
}

// 速度档位点击 (慢 0, 正常 1, 快 2)
function onSpeedTrackClick(e) {
    const track = document.getElementById('speed-track');
    const rect = track.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const ratio = Math.max(0, Math.min(1, clickX / rect.width));

    if (ratio < 0.33) {
        speedIndex = 0; // 慢
    } else if (ratio < 0.66) {
        speedIndex = 1; // 正常
    } else {
        speedIndex = 2; // 快
    }
    updateSpeedUI();
    saveCurrentInputsToProfile();
}

function updateSpeedUI() {
    const percent = speedIndex === 0 ? 0 : (speedIndex === 1 ? 50 : 100);
    document.getElementById('speed-thumb').style.left = percent + '%';
}

// LED 亮度拖拽
function startDragBrightness(e) {
    updateBrightnessFromEvent(e);
    const onMouseMove = (ev) => updateBrightnessFromEvent(ev);
    const onMouseUp = () => {
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', onMouseUp);
        saveCurrentInputsToProfile();
    };
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);
}

function updateBrightnessFromEvent(e) {
    const track = document.getElementById('brightness-track');
    const rect = track.getBoundingClientRect();
    let ratio = (e.clientX - rect.left) / rect.width;
    ratio = Math.max(0.05, Math.min(1.0, ratio));
    brightnessVal = ratio;
    const pct = Math.round(ratio * 100);
    document.getElementById('brightness-fill').style.width = pct + '%';
    document.getElementById('brightness-thumb').style.left = pct + '%';
    document.getElementById('brightness-val-text').textContent = pct + '%';
}

// 粗细拖拽
function startDragThickness(e) {
    updateThicknessFromEvent(e);
    const onMouseMove = (ev) => updateThicknessFromEvent(ev);
    const onMouseUp = () => {
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', onMouseUp);
    };
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);
}

function updateThicknessFromEvent(e) {
    const track = document.getElementById('thickness-track');
    const rect = track.getBoundingClientRect();
    let ratio = (e.clientX - rect.left) / rect.width;
    ratio = Math.max(0.2, Math.min(2.0, ratio * 2.0));
    thicknessVal = ratio;
    const pct = Math.round((ratio / 2.0) * 100);
    document.getElementById('thickness-fill').style.width = pct + '%';
    document.getElementById('thickness-thumb').style.left = pct + '%';
    document.getElementById('thickness-val-text').textContent = ratio.toFixed(1) + 'x';
}

// 颜色模式切换 (样式 / 随机)
function onColorModeChange(mode) {
    colorMode = mode;
    document.getElementById('preset-select-wrapper').style.opacity = (mode === 'random') ? '0.4' : '1';
    document.getElementById('gradient-editor-row').style.opacity = (mode === 'random') ? '0.4' : '1';
    saveCurrentInputsToProfile();
}

// 预设主题切换
function onPresetThemeChange(val) {
    currentPresetTheme = val;
    if (GRADIENT_PRESETS[val]) {
        gradientStops = JSON.parse(JSON.stringify(GRADIENT_PRESETS[val]));
        selectedStopId = gradientStops[0].id;
        renderGradientStops();
        saveCurrentInputsToProfile();
    }
}

// ========================================================
// 9. 多阶渐变色标编辑器核心逻辑
// ========================================================
function renderGradientStops() {
    const container = document.getElementById('gradient-track-container');
    // 保留渐变条，清理已存在的手柄
    container.querySelectorAll('.gradient-stop-pin').forEach(pin => pin.remove());

    gradientStops.sort((a, b) => a.pos - b.pos);

    // 构造 linear-gradient CSS 字符串
    const stopsCss = gradientStops.map(s => `${s.color} ${(s.pos * 100).toFixed(1)}%`).join(', ');
    document.getElementById('gradient-bar').style.background = `linear-gradient(to right, ${stopsCss})`;

    gradientStops.forEach(stop => {
        const pin = document.createElement('div');
        pin.className = 'gradient-stop-pin' + (stop.id === selectedStopId ? ' selected' : '');
        pin.style.left = (stop.pos * 100) + '%';
        pin.style.backgroundColor = stop.color;
        pin.title = `双击更改颜色 (当前位置: ${Math.round(stop.pos * 100)}%)`;

        // 单击选中
        pin.onmousedown = (e) => {
            e.stopPropagation();
            selectedStopId = stop.id;
            renderGradientStops();
            startDragStopPin(e, stop);
        };

        // 双击调用系统拾色器
        pin.ondblclick = (e) => {
            e.stopPropagation();
            selectedStopId = stop.id;
            const picker = document.getElementById('hidden-color-picker');
            picker.value = stop.color;
            picker.click();
        };

        container.appendChild(pin);
    });
}

function onGradientTrackClick(e) {
    const track = document.getElementById('gradient-bar');
    const rect = track.getBoundingClientRect();
    const pos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));

    // 计算点击处在当前渐变下的插值色彩
    const sampledColor = sampleGradientColor(pos);
    const newId = Date.now();
    gradientStops.push({
        id: newId,
        pos: pos,
        color: sampledColor
    });
    selectedStopId = newId;
    renderGradientStops();
    saveCurrentInputsToProfile();
}

function addGradientStop() {
    let nextPos = 0.5;
    const newId = Date.now();
    gradientStops.push({
        id: newId,
        pos: nextPos,
        color: sampleGradientColor(nextPos)
    });
    selectedStopId = newId;
    renderGradientStops();
    saveCurrentInputsToProfile();
}

function removeSelectedStop() {
    if (gradientStops.length <= 2) {
        showToast('⚠️ 渐变色条最少保留 2 个色标！');
        return;
    }
    gradientStops = gradientStops.filter(s => s.id !== selectedStopId);
    selectedStopId = gradientStops[0].id;
    renderGradientStops();
    saveCurrentInputsToProfile();
}

function startDragStopPin(e, stop) {
    const track = document.getElementById('gradient-bar');
    const rect = track.getBoundingClientRect();

    const onMouseMove = (ev) => {
        let newPos = (ev.clientX - rect.left) / rect.width;
        newPos = Math.max(0, Math.min(1, newPos));
        stop.pos = newPos;
        renderGradientStops();
    };

    const onMouseUp = () => {
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', onMouseUp);
        saveCurrentInputsToProfile();
    };

    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', onMouseUp);
}

function onColorPickerSelected(hex) {
    const curStop = gradientStops.find(s => s.id === selectedStopId);
    if (curStop) {
        curStop.color = hex.toUpperCase();
        renderGradientStops();
        saveCurrentInputsToProfile();
    }
}

// 从当前多阶色标插值获取任意位置的颜色 [r, g, b]
function sampleGradientColor(ratio) {
    if (gradientStops.length === 0) return '#FF1929';
    if (gradientStops.length === 1) return gradientStops[0].color;

    const r = Math.max(0, Math.min(1, ratio));
    if (r <= gradientStops[0].pos) return gradientStops[0].color;
    if (r >= gradientStops[gradientStops.length - 1].pos) return gradientStops[gradientStops.length - 1].color;

    for (let i = 0; i < gradientStops.length - 1; ++i) {
        const s1 = gradientStops[i];
        const s2 = gradientStops[i + 1];
        if (r >= s1.pos && r <= s2.pos) {
            const range = s2.pos - s1.pos || 0.001;
            const t = (r - s1.pos) / range;
            const c1 = hexToRgb(s1.color);
            const c2 = hexToRgb(s2.color);
            const red = Math.round(c1[0] + (c2[0] - c1[0]) * t);
            const grn = Math.round(c1[1] + (c2[1] - c1[1]) * t);
            const blu = Math.round(c1[2] + (c2[2] - c1[2]) * t);
            return rgbToHex([red, grn, blu]);
        }
    }
    return gradientStops[0].color;
}

// ========================================================
// 10. 60 FPS 虚拟键盘灯效渲染引擎 (支持 8 方向与多阶色彩)
// ========================================================
function getPeriodMsFromSpeed() {
    if (speedIndex === 0) return 5500; // 慢
    if (speedIndex === 1) return 3200; // 正常
    return 1600;                       // 快
}

// 8 方向单位向量
const DIR_VECTORS = {
    'up':      { x:  0.0, y: -1.0 },
    'down':    { x:  0.0, y:  1.0 },
    'left':    { x: -1.0, y:  0.0 },
    'right':   { x:  1.0, y:  0.0 },
    'diag_ur': { x:  0.707, y: -0.707 },
    'diag_dl': { x: -0.707, y:  0.707 },
    'diag_ul': { x: -0.707, y: -0.707 },
    'diag_dr': { x:  0.707, y:  0.707 },
    'spread':  { x:  0.0, y:  0.0 } // 往复中心扩散
};

function renderLightingLoop(timestamp) {
    const t = timestamp || 0;
    const period = getPeriodMsFromSpeed();

    // 键盘响应型灯效 (reactive/ripple) 无自动演练：仅由真实物理敲击或虚拟键点击驱动

    const dirVec = DIR_VECTORS[currentDirection] || DIR_VECTORS['right'];

    keyElements.forEach(item => {
        let r = 0, g = 0, b = 0;

        if (!isMasterLightOn) {
            // 开关关闭，全黑
            r = 0; g = 0; b = 0;
        } else if (currentEffect === 'static') {
            // 恒亮模式：取第一个色标颜色
            const col = hexToRgb(gradientStops[0].color);
            r = col[0]; g = col[1]; b = col[2];
            // 模拟灯效 (仅常亮类)：真实按压的按键叠加白炽增亮并逐帧衰减 (与 C++ StaticEffect analog 对齐)
            if (analogActive()) {
                const extra = analogDecays[item.name] || 0;
                if (extra > 0) {
                    analogDecays[item.name] = Math.max(0, extra - 0.035);
                    r = Math.min(255, r + extra * (255 - r));
                    g = Math.min(255, g + extra * (255 - g));
                    b = Math.min(255, b + extra * (255 - b));
                }
            }
        } else if (currentEffect === 'breathing') {
            // 呼吸模式：正弦循环渐隐
            const phase = (t % period) / period;
            const factor = 0.5 - 0.5 * Math.cos(2.0 * Math.PI * phase);
            const col1 = hexToRgb(gradientStops[0].color);
            const col2 = hexToRgb(gradientStops.length > 1 ? gradientStops[1].color : '#000000');
            r = col1[0] * factor + col2[0] * (1.0 - factor);
            g = col1[1] * factor + col2[1] * (1.0 - factor);
            b = col1[2] * factor + col2[2] * (1.0 - factor);
        } else if (currentEffect === 'color_cycle') {
            // 全彩谱循环
            const hue = ((t % period) / period) * 360.0;
            [r, g, b] = hsvToRgb(hue, 1.0, 1.0);
        } else if (currentEffect === 'wave') {
            // 彩虹波浪：支持 8 方向向量投影计算！
            let proj = 0.0;
            if (currentDirection === 'spread') {
                const centerCol = 8.0;
                const centerRow = 2.0;
                const dx = (item.col - centerCol);
                const dy = (item.row - centerRow) * 2.0;
                proj = Math.sqrt(dx * dx + dy * dy) / 10.0;
            } else {
                // 投影在指定方向上的比例 (0.0 ~ 1.0)
                const normX = item.col / 16.0;
                const normY = item.row / 4.0;
                proj = (normX * dirVec.x + normY * dirVec.y) * thicknessVal;
            }

            const phase = (t % period) / period;
            const ratio = ((proj - phase + 100.0) % 1.0);
            const hexColor = sampleGradientColor(ratio);
            const col = hexToRgb(hexColor);
            r = col[0]; g = col[1]; b = col[2];
        } else if (currentEffect === 'starry_night') {
            // 星空：繁星微光随机闪烁 (参考图 3)
            if (colorMode === 'random') {
                const seed = (item.col * 19 + item.row * 37) % 360;
                const starPhase = ((t + seed * 40) % 2200) / 2200;
                const starGlow = Math.max(0, Math.sin(starPhase * Math.PI) * 1.5 - 0.5);
                [r, g, b] = hsvToRgb(seed, 1.0, starGlow);
            } else {
                const seed = (item.col * 17 + item.row * 31) % 100;
                const starPhase = ((t + seed * 50) % 2000) / 2000;
                const starGlow = Math.max(0, Math.sin(starPhase * Math.PI) * 1.5 - 0.5);
                const col = hexToRgb(sampleGradientColor(seed / 100.0));
                r = col[0] * starGlow;
                g = col[1] * starGlow;
                b = col[2] * starGlow;
            }
        } else if (currentEffect === 'quicksand') {
            // 流沙模式
            const phase = (t % period) / period;
            const wave = Math.sin((item.col * 0.4 * dirVec.x + item.row * 0.8 * dirVec.y) + (phase * 2 * Math.PI));
            const factor = wave * 0.5 + 0.5;
            const col = hexToRgb(sampleGradientColor(factor));
            r = col[0]; g = col[1]; b = col[2];
        } else if (currentEffect === 'current') {
            // 电流模式：电光雷鸣
            const phase = (t % (period / 2)) / (period / 2);
            const isPulse = (Math.abs(item.col - (phase * 16.0)) < 1.8 * thicknessVal);
            if (isPulse) {
                r = 255; g = 255; b = 255; // 核心白炽
            } else {
                const col = hexToRgb(gradientStops[0].color);
                r = col[0] * 0.15;
                g = col[1] * 0.15;
                b = col[2] * 0.15;
            }
        } else if (currentEffect === 'raindrop') {
            // 雨滴淅沥
            const seed = (item.col * 23 + item.row * 47) % 80;
            const dropPhase = ((t + seed * 80) % 2800) / 2800;
            const dropGlow = Math.pow(Math.max(0, 1.0 - dropPhase * 4), 2);
            const col = hexToRgb(gradientStops[0].color);
            r = col[0] * (0.15 + 0.85 * dropGlow);
            g = col[1] * (0.15 + 0.85 * dropGlow);
            b = col[2] * (0.15 + 0.85 * dropGlow);
        } else if (currentEffect === 'reactive' || currentEffect === 'ripple') {
            // 触发与水波涟漪
            let totalGlow = 0.0;
            const decay = reactiveDecays[item.name] || 0;
            if (decay > 0) {
                totalGlow += decay;
                reactiveDecays[item.name] = Math.max(0, decay - 0.025);
            }

            const keyCenterCol = item.col + item.width / 2.0;
            const keyRow = item.row;

            for (const rip of activeRipples) {
                const currentRadius = (t - rip.startTime) * rip.speed;
                if (currentRadius <= rip.maxRadius) {
                    const dx = keyCenterCol - rip.col;
                    const dy = (keyRow - rip.row) * 2.2;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    const diff = Math.abs(dist - currentRadius);
                    if (diff < 1.8) {
                        const waveFactor = (1.0 - diff / 1.8) * (1.0 - currentRadius / rip.maxRadius);
                        totalGlow += waveFactor * 0.95;
                    }
                }
            }

            const baseCol = hexToRgb(gradientStops[0].color);
            if (totalGlow > 0.01) {
                const factor = Math.min(1.0, totalGlow);
                r = baseCol[0] * factor;
                g = baseCol[1] * factor;
                b = baseCol[2] * factor;

                if (totalGlow > 0.8) {
                    const peak = Math.min(1.0, (totalGlow - 0.8) * 1.5);
                    r += (255 - r) * peak;
                    g += (255 - g) * peak;
                    b += (255 - b) * peak;
                }
            } else {
                r = 6; g = 10; b = 18;
            }
        }

        // 应用亮度权重
        r = Math.min(255, Math.floor(r * brightnessVal));
        g = Math.min(255, Math.floor(g * brightnessVal));
        b = Math.min(255, Math.floor(b * brightnessVal));

        // 动态注入样式与背光光晕
        const keyEl = item.el;
        keyEl.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;

        const luminance = 0.299 * r + 0.587 * g + 0.114 * b;
        if (luminance > 45) {
            keyEl.style.color = '#fff';
            keyEl.style.boxShadow = `0 0 16px rgba(${r}, ${g}, ${b}, 0.8), inset 0 0 5px rgba(255,255,255,0.45)`;
            keyEl.style.borderColor = `rgba(${Math.min(255, r + 50)}, ${Math.min(255, g + 50)}, ${Math.min(255, b + 50)}, 0.95)`;
        } else {
            keyEl.style.color = 'var(--text-primary)';
            keyEl.style.boxShadow = `inset 0 -2px 0 rgba(0,0,0,0.5), 0 2px 4px rgba(0,0,0,0.3)`;
            keyEl.style.borderColor = '#28303f';
        }
    });

    activeRipples = activeRipples.filter(rip => (t - rip.startTime) * rip.speed <= rip.maxRadius);
    requestAnimationFrame(renderLightingLoop);
}

// 按键物理响应触发
function triggerKeyReactive(keyName, fromPhysical = false) {
    reactiveDecays[keyName] = 1.4;
    analogDecays[keyName] = 1.0;
    lastUserKeystrokeTime = performance.now();

    const targetKey = keyElements.find(k => k.name === keyName);
    if (targetKey) {
        targetKey.el.classList.add('key-pressed');

        activeRipples.push({
            col: targetKey.col + targetKey.width / 2.0,
            row: targetKey.row,
            startTime: performance.now(),
            maxRadius: 18.0,
            speed: 0.016,
            color: hexToRgb(gradientStops[0].color)
        });

        if (activeRipples.length > 10) activeRipples.shift();
    }

    if (fromPhysical) {
        const badge = document.getElementById('stage-badge');
        if (badge) {
            badge.textContent = `● 捕获实体按键: ${keyName} (已激发光晕与涟漪)`;
            badge.style.color = 'var(--rog-cyan)';
            setTimeout(() => {
                badge.textContent = '● 预览时钟：60 FPS 硬件同步驱动';
            }, 1200);
        }
    }
}

function releaseKeyReactive(keyName) {
    const targetKey = keyElements.find(k => k.name === keyName);
    if (targetKey) {
        targetKey.el.classList.remove('key-pressed');
    }
}

// 物理键盘监听
const CODE_TO_KEY_MAP = {
    'Escape': 'ESC', 'Digit1': '1', 'Digit2': '2', 'Digit3': '3', 'Digit4': '4', 'Digit5': '5',
    'Digit6': '6', 'Digit7': '7', 'Digit8': '8', 'Digit9': '9', 'Digit0': '0',
    'Minus': '-', 'Equal': '=', 'Backspace': 'BACKSPACE', 'Insert': 'INS',
    'Tab': 'TAB', 'KeyQ': 'Q', 'KeyW': 'W', 'KeyE': 'E', 'KeyR': 'R', 'KeyT': 'T',
    'KeyY': 'Y', 'KeyU': 'U', 'KeyI': 'I', 'KeyO': 'O', 'KeyP': 'P',
    'BracketLeft': '[', 'BracketRight': ']', 'Backslash': '\\', 'Delete': 'DEL',
    'CapsLock': 'CAPS', 'KeyA': 'A', 'KeyS': 'S', 'KeyD': 'D', 'KeyF': 'F', 'KeyG': 'G',
    'KeyH': 'H', 'KeyJ': 'J', 'KeyK': 'K', 'KeyL': 'L', 'Semicolon': ';', 'Quote': '\'',
    'Enter': 'ENTER', 'PageUp': 'PGUP', 'ShiftLeft': 'L_SHIFT',
    'KeyZ': 'Z', 'KeyX': 'X', 'KeyC': 'C', 'KeyV': 'V', 'KeyB': 'B', 'KeyN': 'N',
    'KeyM': 'M', 'Comma': ',', 'Period': '.', 'Slash': '/', 'ShiftRight': 'R_SHIFT',
    'ArrowUp': 'UP', 'PageDown': 'PGDN', 'ControlLeft': 'L_CTRL', 'MetaLeft': 'L_WIN',
    'AltLeft': 'L_ALT', 'Space': 'SPACE', 'AltRight': 'R_ALT', 'ControlRight': 'R_CTRL',
    'ArrowLeft': 'LEFT', 'ArrowDown': 'DOWN', 'ArrowRight': 'RIGHT'
};

window.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
    const keyName = CODE_TO_KEY_MAP[e.code] || (e.key ? e.key.toUpperCase() : null);
    if (keyName) triggerKeyReactive(keyName, true);
});

window.addEventListener('keyup', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
    const keyName = CODE_TO_KEY_MAP[e.code] || (e.key ? e.key.toUpperCase() : null);
    if (keyName) releaseKeyReactive(keyName);
});

// ========================================================
// 11. 配置加载、同步与持久化保存 (打通后端 daemon)
// ========================================================
async function loadConfig() {
    try {
        const res = await fetch('/api/config');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        currentConfig = await res.json();

        currentProfileName = currentConfig.default_profile || 'desktop';
        if (currentConfig.profiles && currentConfig.profiles[currentProfileName]) {
            const prof = currentConfig.profiles[currentProfileName];
            // 先捕获配置中的模拟开关状态 (selectEffect 内部的保存动作会用当前内存值覆写 prof.analog)
            const savedAnalog = (prof.analog === true);
            if (prof.type) {
                selectEffect(prof.type);
            }
            // 仅常亮类灯效恢复模拟开关状态 (键盘响应型灯效无模拟触发)
            if (prof.type === 'static' && savedAnalog !== isAnalogEnabled) {
                isAnalogEnabled = savedAnalog;
                setAnalogSwitchUI(savedAnalog);
            }
            if (prof.color) {
                gradientStops[0].color = rgbToHex(prof.color);
                renderGradientStops();
            }
            if (prof.period_ms) {
                if (prof.period_ms > 4500) speedIndex = 0;
                else if (prof.period_ms > 2400) speedIndex = 1;
                else speedIndex = 2;
                updateSpeedUI();
            }
            if (prof.direction) {
                setDirection(prof.direction);
            }
        }
        renderRulesTab();
    } catch (e) {
        console.warn('获取配置失败:', e);
    }
}

function saveCurrentInputsToProfile() {
    if (!currentConfig || !currentConfig.profiles[currentProfileName]) return;
    const prof = currentConfig.profiles[currentProfileName];

    prof.type = currentEffect;
    prof.direction = currentDirection;
    prof.speed_index = speedIndex;
    prof.period_ms = getPeriodMsFromSpeed();
    prof.brightness = brightnessVal;
    // 模拟触发仅存在于常亮类灯效
    prof.analog = (currentEffect === 'static') ? isAnalogEnabled : false;

    // 映射主要颜色给 C++ 效果引擎
    if (gradientStops.length > 0) {
        prof.color = hexToRgb(gradientStops[0].color);
        prof.color1 = hexToRgb(gradientStops[0].color);
    }
    if (gradientStops.length > 1) {
        prof.color2 = hexToRgb(gradientStops[1].color);
    }
}

async function saveConfiguration() {
    saveCurrentInputsToProfile();
    try {
        const res = await fetch('/api/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(currentConfig)
        });
        const ret = await res.json();
        if (res.ok) {
            showToast('✅ ' + (ret.message || '配置已成功保存，daemon 已自动热重载！'));
        } else {
            showToast('❌ 保存失败: ' + (ret.message || '未知错误'));
        }
    } catch (e) {
        showToast('❌ 请求失败: ' + e.message);
    }
}

// 选项卡切换
function switchMainTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    if (tab === 'lighting') {
        document.querySelector('.tab-btn:nth-child(1)').classList.add('active');
        document.getElementById('tab-lighting-content').style.display = 'grid';
        document.getElementById('tab-rules-content').style.display = 'none';
    } else {
        document.querySelector('.tab-btn:nth-child(2)').classList.add('active');
        document.getElementById('tab-lighting-content').style.display = 'none';
        document.getElementById('tab-rules-content').style.display = 'grid';
        renderRulesTab();
    }
}

// 前台规则渲染与编辑
function renderRulesTab() {
    const tbody = document.getElementById('rules-tbody');
    tbody.innerHTML = '';
    if (!currentConfig || !currentConfig.rules) return;

    currentConfig.rules.forEach((rule, idx) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><input type="text" class="input-text" style="width: 200px;" value="${rule.process || ''}" onchange="currentConfig.rules[${idx}].process = this.value.trim().toLowerCase()"></td>
            <td><input type="text" class="input-text" style="width: 180px;" value="${rule.profile || ''}" onchange="currentConfig.rules[${idx}].profile = this.value.trim()"></td>
            <td>
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input type="checkbox" ${rule.suppress_web_ui ? 'checked' : ''} onchange="currentConfig.rules[${idx}].suppress_web_ui = this.checked">
                    <span style="font-size: 12px; color: var(--text-secondary);">🎮 游戏模式自动关停网页服务</span>
                </label>
            </td>
            <td><button class="btn-rog" style="padding: 4px 10px; font-size: 11px; background: #441118;" onclick="deleteRule(${idx})">删除</button></td>
        `;
        tbody.appendChild(tr);
    });
}

function addRule() {
    if (!currentConfig.rules) currentConfig.rules = [];
    currentConfig.rules.push({ process: '', profile: 'desktop', suppress_web_ui: false });
    renderRulesTab();
}

function deleteRule(idx) {
    currentConfig.rules.splice(idx, 1);
    renderRulesTab();
}

// 心跳检测与游戏降级
let consecutiveFails = 0;
let isConnected = true;

function startHeartbeat() {
    setInterval(async () => {
        try {
            const res = await fetch('/api/status', { cache: 'no-store' });
            if (res.ok) {
                consecutiveFails = 0;
                if (!isConnected) {
                    isConnected = true;
                    document.getElementById('game-mode-overlay').classList.remove('visible');
                    loadConfig();
                }
            } else {
                handleDisconnect();
            }
        } catch (e) {
            handleDisconnect();
        }
    }, 1500);
}

function handleDisconnect() {
    consecutiveFails++;
    if (consecutiveFails >= 2 && isConnected) {
        isConnected = false;
        document.getElementById('game-mode-overlay').classList.add('visible');
    }
}

function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3500);
}

// 色彩转换工具函数
function rgbToHex(rgb) {
    if (!rgb || rgb.length < 3) return '#000000';
    return '#' + rgb.slice(0, 3).map(x => Math.max(0, Math.min(255, Math.floor(x))).toString(16).padStart(2, '0')).join('').toUpperCase();
}

function hexToRgb(hex) {
    let clean = hex.replace('#', '');
    if (clean.length === 3) clean = clean.split('').map(c => c + c).join('');
    const num = parseInt(clean, 16);
    return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
}

function hsvToRgb(h, s, v) {
    let c = v * s;
    let x = c * (1 - Math.abs(((h / 60) % 2) - 1));
    let m = v - c;
    let r1 = 0, g1 = 0, b1 = 0;
    if (h >= 0 && h < 60) { r1 = c; g1 = x; b1 = 0; }
    else if (h >= 60 && h < 120) { r1 = x; g1 = c; b1 = 0; }
    else if (h >= 120 && h < 180) { r1 = 0; g1 = c; b1 = x; }
    else if (h >= 180 && h < 240) { r1 = 0; g1 = x; b1 = c; }
    else if (h >= 240 && h < 300) { r1 = x; g1 = 0; b1 = c; }
    else if (h >= 300 && h < 360) { r1 = c; g1 = 0; b1 = x; }
    return [Math.round((r1 + m) * 255), Math.round((g1 + m) * 255), Math.round((b1 + m) * 255)];
}
</script>

</body>
</html>
